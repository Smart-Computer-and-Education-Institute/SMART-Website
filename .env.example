# Copy this file to .env for local development:
#     cp .env.example .env
# Then fill in real values below. .env is in .gitignore and must never
# be committed. In production (Vercel), set these same names under
# Project Settings -> Environment Variables instead of using a file.

# --- Admin login (required) ---------------------------------------
# The only account the admin panel accepts.
ADMIN_EMAIL=admin@smartinstitute.com

# NEVER put a plain-text password here. Generate the hash with:
#     npm run hash-password -- "YourNewPassword123!"
# and paste the printed line below.
ADMIN_PASSWORD_HASH=$2a$12$bCGgkUKd5sc1QjEmEJtqYuSR2e7xyFNLjDOf/Xi9ygwWhxGwY9m6u

# A long, random, secret string used to sign login sessions. Generate
# one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=7d5e32c63c2c98b90816902351f26c7891534ee48f0b76ef996e4438260e4ee7df300c50cb38da8da476d1696cc2d01f

# --- Database (required in production, optional locally) -----------
# A free MongoDB Atlas connection string. If this is left blank, the
# app falls back to reading/writing the JSON files in /data, which is
# fine for local development but does NOT work once deployed to
# Vercel (see docs/SECURITY_AND_DEPLOYMENT.md).
MONGODB_URI=

# --- File uploads (required in production, optional locally) -------
# Set automatically by Vercel once you connect a Blob store to this
# project (Vercel dashboard -> Storage -> Create Database -> Blob).
# If left blank, uploaded photos are saved to the local /img folder
# instead, which again does not persist on Vercel.
BLOB_READ_WRITE_TOKEN=

# --- Misc ------------------------------------------------------------
# Vercel sets this automatically; only set it yourself for local
# testing of production-only behavior (secure cookies, etc.).
# NODE_ENV=production
